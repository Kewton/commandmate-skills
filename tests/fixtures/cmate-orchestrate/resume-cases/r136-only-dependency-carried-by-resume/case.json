{
  "description": "CommandMate#3008: #200 は #201 に依存する。`--only 201` で #201 だけを走らせて pass させたあと、`--resume --only 200` で #200 を選ぶと、選外の #201 への依存は **前回 attempt が pass させた記録**として満たされているので断られない（`--resume` を付けない `--only 200` は d137 で `invalid_input`）。#200 だけが dispatch され、#201 は送り直されず、carried の pass 記録がそのまま最後の wave entry に転記される（「excluded」で上書きされない）。",
  "plan": {
    "issues_fixture": "cases/02-explicit-dependency/issues.json",
    "orchestrate_args": [
      "200",
      "201",
      "--profile",
      "node-commandmate",
      "--max-parallel",
      "3",
      "--run-id",
      "plan"
    ]
  },
  "attempts": [
    {
      "scenario": "attempt-1.json",
      "dispatch_args": [
        "--only",
        "201",
        "--expect-branch",
        "feature/integration"
      ],
      "expect": {
        "exit": 0,
        "status": "success",
        "stop_reason": "completed",
        "sent": [
          201
        ],
        "never_sent": [
          200
        ],
        "worker_states": {
          "200": "not_dispatched",
          "201": "completed"
        },
        "report_file": "dispatch-report.json",
        "history_length": 1
      }
    },
    {
      "scenario": "attempt-2.json",
      "resume": true,
      "dispatch_args": [
        "--only",
        "200",
        "--expect-branch",
        "feature/integration"
      ],
      "expect": {
        "exit": 0,
        "status": "success",
        "stop_reason": "completed",
        "sent": [
          200
        ],
        "never_sent": [
          201
        ],
        "worker_states": {
          "200": "completed",
          "201": "completed"
        },
        "verification_outcomes": {
          "200": "pass",
          "201": "pass"
        },
        "worker_notes_include": {
          "201": [
            "carried over from attempt 1"
          ]
        },
        "plan_scope": {
          "plan_issues": [
            200,
            201
          ],
          "selected": [
            200
          ],
          "deselected": [
            201
          ],
          "inherited": false
        },
        "report_file": "resume-attempt-2/dispatch-report.json",
        "history_length": 2
      }
    }
  ]
}
