{
  "id": "companions-invalid-glob",
  "repository": "Kewton/CommandMate",
  "base": "origin/develop",
  "branch_template": "feature/issue-{number}-{slug}",
  "worktree_template": "../{repo}-issue-{number}-{slug}",
  "baseline": [
    "bundle exec rspec"
  ],
  "verified": true,
  "scope_companions": {
    "derive": [
      {
        "when": "app/{dir}{base}.rb",
        "add": [
          "spec/{dir}**/{base}_spec.rb"
        ]
      }
    ]
  }
}
