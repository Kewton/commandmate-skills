{
  "id": "pr-title-template-declared",
  "repository": "Kewton/CommandMate",
  "base": "origin/develop",
  "branch_template": "feature/issue-{number}-{slug}",
  "worktree_template": "../{repo}-issue-{number}-{slug}",
  "baseline": [
    "bundle exec rspec"
  ],
  "verified": true,
  "pr_title_template": "{{type}}({{scope}}): {{title}} (#{{number}})"
}
