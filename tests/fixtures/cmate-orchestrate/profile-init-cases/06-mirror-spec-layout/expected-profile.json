{
  "id": "node-sprocket-web",
  "repository": "Acme/sprocket-web",
  "base": "origin/main",
  "branch_template": "feature/issue-{number}-{slug}",
  "worktree_template": "../{repo}-issue-{number}-{slug}",
  "baseline": [
    "npm ci",
    "npm test"
  ],
  "verified": false,
  "scope_companions": {
    "derive": [
      {
        "when": "src/{dir}{base}.ts",
        "add": [
          "spec/{dir}{base}_spec.ts"
        ]
      }
    ]
  }
}
