    "send_counts": {
      "100": 1
    },
    "worker_states": {
      "100": "completed"
    },
    "cli_subcommand_counts": {
      "interrupt": 0,
      "respond": 0
    },
    "absent_blocking_codes": [
      "stale_prompt_on_session"
    ],
    "absent_limitation_codes": [
      "stale_prompt_interrupted"
    ]
  }
