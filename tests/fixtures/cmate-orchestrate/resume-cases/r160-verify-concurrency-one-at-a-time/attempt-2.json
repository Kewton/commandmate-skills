      "state": "completed",
      "commits": 1,
      "uncommitted": false,
      "pass_gates": [
        "lint",
        "test"
      ],
      "verify_hold_ms": 1000
    },
    "101": {
      "state": "completed",
      "commits": 1,
      "uncommitted": false,
      "pass_gates": [
        "lint",
        "test"
      ],
      "verify_hold_ms": 1000
    },
    "102": {
      "state": "completed",
      "commits": 1,
      "uncommitted": false,
      "pass_gates": [
        "lint",
        "test"
      ],
      "verify_hold_ms": 1000
    }
  }
}
