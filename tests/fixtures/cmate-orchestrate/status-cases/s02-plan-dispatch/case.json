{
  "description": "plan + 完走した dispatch。各 Issue の worker_state と verification.outcome が出て、merge / uat は「未実行」。dispatch が完走しているので次アクションは merge の実行コマンドになる。",
  "expect": {
    "exit": 0,
    "latest_phase": "dispatch",
    "phase_states": { "plan": "ok", "dispatch": "ok", "merge": "not_run", "uat": "not_run" },
    "unreadable_paths": [],
    "issues": [200, 201],
    "issue_states": {
      "200": { "plan": "ok", "dispatch": "ok", "merge": "not_run", "uat": "not_run" },
      "201": { "plan": "ok", "dispatch": "ok", "merge": "not_run", "uat": "not_run" }
    },
    "dispatch": {
      "200": { "worker_state": "completed", "verification_outcome": "pass", "wave_index": 1, "gates": ["work-evidence=pass", "baseline=pass"] },
      "201": { "worker_state": "completed", "verification_outcome": "pass", "wave_index": 0 }
    },
    "run_next": ["merge/not_run/not_run"],
    "issue_next": { "200": [], "201": [] },
    "hints_include": { "not_run": "merge.mjs --plan" },
    "text_includes": ["completed/pass", "status=success / stop=completed"]
  }
}
